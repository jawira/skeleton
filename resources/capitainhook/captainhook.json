{
  "ansi-colors": true,
  "commit-msg": {
    "enabled": true,
    "actions": [
      {
        "action": "CaptainHook.Message.MustMatchRegex",
        "options": {
          "regex": "#^(feat|fix|docs|style|refactor|test|chore)(\\(.+\\))?(!)?: .+$#s"
        }
      }
    ]
  },
  "pre-commit": {
    "enabled": true,
    "actions": [
      {
        "action": "phing qa"
      }
    ]
  }
}
